<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0b0e14">
<title>TikTok Live Panel — /dash</title>
<link rel="stylesheet" href="/dash.css">
</head>
<body>
<header class="topbar">
  <div class="brand">
    <span class="logo">TT</span>
    <div class="brand-text">
      <strong>TikTok Live Panel</strong>
      <small>Canlı yayın olay akışı</small>
    </div>
  </div>
  <div class="server-pill" id="serverPill">
    <span class="dot" id="serverDot"></span>
    <span id="serverText">Sunucu</span>
  </div>
</header>
<main class="layout" id="layout">

  <section class="card connect-card">
    <h2 class="card-title">🎥 Canlı Yayına Bağlan</h2>
    <p class="hint">Kullanıcı adını <code>@</code> ile gir, örn. <code>@elvin_hesenov041</code></p>
    <div class="input-row">
      <div class="tag-input">
        <span class="at">@</span>
        <input id="username" type="text" autocomplete="off" spellcheck="false"
               placeholder="elvin_hesenov041" aria-label="TikTok kullanıcı adı">
      </div>
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" id="btnConnect">Bağlan</button>
      <button class="btn btn-ghost" id="btnDisconnect" disabled>Bağlantıyı Kes</button>
    </div>
    <div class="quick" id="quickTags"></div>
    <div class="status-grid">
      <div class="status-item"><small>Durum</small><strong id="stStatus">—</strong></div>
      <div class="status-item"><small>Oda ID</small><strong id="stRoom">—</strong></div>
      <div class="status-item"><small>İzleyici</small><strong id="stViewers">0</strong></div>
      <div class="status-item"><small>İstemci</small><strong id="stClients">0</strong></div>
    </div>
  </section>

</main>
<footer class="foot"><span id="connInfo">Bağlantı yok</span></footer>
<script src="/dash.js"></script>
</body>
</html>
