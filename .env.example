# Sunucu
PORT=3000
HOST=127.0.0.1
NODE_ENV=production

# CORS
CORS_ORIGIN=*

# Oda / bağlantı yönetimi
CLEANUP_TIMEOUT=300000
MAX_RECONNECT_ATTEMPTS=3
HEARTBEAT_INTERVAL=30000
MAX_CONNECTIONS_PER_USER=5
MAX_TOTAL_ROOMS=100
EVENT_HISTORY_SIZE=200

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
SSE_RATE_LIMIT_MAX=30

# Sıkıştırma
COMPRESSION_LEVEL=6
COMPRESSION_THRESHOLD=1024

# Loglama
LOG_LEVEL=info
LOG_DIR=logs
